#Using loop
def find_larger(x,y):
    if x > y:
        return x
    elif x < y:
        return y
    else:
        return "Both numbers are equal"

if __name__ == '__main__':
    print(find_larger(input("Please enter number: "),input("Please enter another number: ")))
