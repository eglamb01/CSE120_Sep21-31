#Recursive Function (Recalls back to itself)
def sum(n):
    if n <= 1:
        return n
    else:
        return n + sum(n - 1)

if __name__ == '__main__':
    n = 5
    print(sum(n))

def factorial(n):
    if n == 0 or n == 1:
        return 1
    else:
        return n * factorial(n - 1)

if __name__ == '__main__':
    n = int(input ("Please Enter Number: "))
    result = (factorial(n))
    print(f"The factorial of {n} is {result}")

